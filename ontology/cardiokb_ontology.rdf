        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#drugObjectProperty"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Drug"/>
        <rdfs:range rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#PharmacologicClass"/>
