    <owl:ObjectProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#VARIANT_IN">
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#variantObjectProperty"/>
