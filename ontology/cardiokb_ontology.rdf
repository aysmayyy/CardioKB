    <owl:ObjectProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#drugLabelAnnotatesGene">
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#DrugLabel"/>
        <rdfs:range rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Gene"/>
        <cardiokb:edgeSource>ClinPGx</cardiokb:edgeSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#drugLabelDescribesDrug">
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#DrugLabel"/>
        <rdfs:range rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Drug"/>
        <cardiokb:edgeSource>ClinPGx</cardiokb:edgeSource>
    </owl:ObjectProperty>

    <!-- Classes - Top-Level Concepts -->

    <owl:Class rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#BiologicalEntity">
        <rdfs:comment>Top-level class for all biological entities in CardioKB</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#ChemicalEntity">
        <rdfs:comment>Top-level class for chemical/drug entities</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#OntologyTerm">
        <rdfs:comment>Top-level class for ontology terms (GO, HPO, etc.)</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#ClinicalEntity">
        <rdfs:comment>Top-level class for clinical data entities</rdfs:comment>
    </owl:Class>

    <!-- Classes - Biological Entities -->

    <owl:Class rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#Gene">
        <rdfs:subClassOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#BiologicalEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#geneSymbol"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <cardiokb:individualLabelPrefix>gene_</cardiokb:individualLabelPrefix>
        <cardiokb:sourceDatabase>NCBI Gene</cardiokb:sourceDatabase>
        <rdfs:comment>Human genes (194,553 nodes)</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#Variant">
        <rdfs:subClassOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#BiologicalEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#variantId"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <cardiokb:individualLabelPrefix>var_</cardiokb:individualLabelPrefix>
        <cardiokb:sourceDatabase>ClinVar</cardiokb:sourceDatabase>
        <rdfs:comment>Genetic variants (4,488,042 nodes)</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#TranscriptionFactor">
        <rdfs:subClassOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#BiologicalEntity"/>
        <cardiokb:individualLabelPrefix>tf_</cardiokb:individualLabelPrefix>
        <cardiokb:sourceDatabase>DoRothEA</cardiokb:sourceDatabase>
        <rdfs:comment>Transcription factors (367 nodes)</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#GeneFamily">
        <rdfs:subClassOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#BiologicalEntity"/>
        <cardiokb:individualLabelPrefix>fam_</cardiokb:individualLabelPrefix>
        <cardiokb:sourceDatabase>HGNC Families</cardiokb:sourceDatabase>
        <rdfs:comment>Gene families (1,934 nodes)</rdfs:comment>
    </owl:Class>

    <!-- Classes - Disease and Medical Entities -->

    <owl:Class rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#Disease">
        <rdfs:subClassOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#ClinicalEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#xrefDiseaseOntology"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <cardiokb:individualLabelPrefix>dis_</cardiokb:individualLabelPrefix>
        <cardiokb:sourceDatabase>Disease Ontology</cardiokb:sourceDatabase>
        <rdfs:comment>Diseases from Disease Ontology (12,012 nodes)</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#Phenotype">
        <rdfs:subClassOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#ClinicalEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#xrefHPO"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <cardiokb:individualLabelPrefix>hp_</cardiokb:individualLabelPrefix>
        <cardiokb:sourceDatabase>HPO</cardiokb:sourceDatabase>
        <rdfs:comment>Human phenotypes (19,389 nodes)</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#Symptom">
        <rdfs:subClassOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#ClinicalEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#xrefMeSH"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <cardiokb:individualLabelPrefix>sym_</cardiokb:individualLabelPrefix>
        <cardiokb:sourceDatabase>NCBI MeSH</cardiokb:sourceDatabase>
        <rdfs:comment>Disease symptoms (966 nodes)</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#ClinicalTrial">
        <rdfs:subClassOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#ClinicalEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#trialId"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <cardiokb:individualLabelPrefix>nct_</cardiokb:individualLabelPrefix>
        <cardiokb:sourceDatabase>ClinicalTrials.gov</cardiokb:sourceDatabase>
        <rdfs:comment>Clinical trials (85,677 nodes)</rdfs:comment>
    </owl:Class>

    <!-- Classes - Chemical/Drug Entities -->

    <owl:Class rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#Drug">
        <rdfs:subClassOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#ChemicalEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#commonName"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <cardiokb:individualLabelPrefix>drug_</cardiokb:individualLabelPrefix>
        <cardiokb:sourceDatabase>DrugBank + CTD</cardiokb:sourceDatabase>
        <rdfs:comment>Drugs and chemicals (24,414 nodes: 19,842 DrugBank + 4,572 CTD unique)</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#SideEffect">
        <rdfs:subClassOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#ChemicalEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#xrefUmlsCUI"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <cardiokb:individualLabelPrefix>se_</cardiokb:individualLabelPrefix>
        <cardiokb:sourceDatabase>SIDER</cardiokb:sourceDatabase>
        <rdfs:comment>Drug side effects (5,734 nodes)</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#PharmacologicClass">
        <rdfs:subClassOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#ChemicalEntity"/>
        <cardiokb:individualLabelPrefix>pc_</cardiokb:individualLabelPrefix>
        <cardiokb:sourceDatabase>DrugCentral</cardiokb:sourceDatabase>
        <rdfs:comment>Drug pharmacologic classes (1,646 nodes)</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#DrugLabel">
        <rdfs:subClassOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#ChemicalEntity"/>
        <cardiokb:individualLabelPrefix>dl_</cardiokb:individualLabelPrefix>
        <cardiokb:sourceDatabase>ClinPGx</cardiokb:sourceDatabase>
        <rdfs:comment>FDA drug labels (378 nodes)</rdfs:comment>
