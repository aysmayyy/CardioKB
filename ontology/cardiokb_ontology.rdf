    <owl:ObjectProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#TESTS_INTERVENTION">
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#clinicalTrialObjectProperty"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#ClinicalTrial"/>
        <rdfs:range rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Drug"/>
        <cardiokb:edgeSource>ClinicalTrials.gov</cardiokb:edgeSource>
    </owl:ObjectProperty>

