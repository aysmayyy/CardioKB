        <rdfs:range rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Gene"/>
        <cardiokb:edgeSource>ClinPGx</cardiokb:edgeSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#AFFECTS_RESPONSE_TO">
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#geneObjectProperty"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Gene"/>
        <rdfs:range rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Drug"/>
        <cardiokb:edgeSource>ClinPGx</cardiokb:edgeSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#AFFECTS_RESPONSE_TO_CLASS">
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#geneObjectProperty"/>
