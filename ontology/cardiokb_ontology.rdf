<?xml version="1.0"?>
<rdf:RDF xmlns="http://cardiokb.org/ontologies/cardiokb.owl#"
     xml:base="http://cardiokb.org/ontologies/cardiokb.owl"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:cardiokb="http://cardiokb.org/ontologies/cardiokb.owl#">

    <owl:Ontology rdf:about="http://cardiokb.org/ontologies/cardiokb.owl">
        <owl:versionIRI rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl/1.0.0"/>
        <cardiokb:language xml:lang="en">English</cardiokb:language>
        <rdfs:comment xml:lang="en">CardioKB - A Cardiovascular Disease Knowledge Graph Ontology

This ontology describes entities relevant to cardiovascular disease etiology, drug discovery, and precision medicine. It integrates 23 data sources including clinical trials, pharmacogenomics, gene expression, and disease associations.

Individuals are modeled as idealized entities corresponding to examples of a certain class. For example, 'aspirin' is an individual of the class Drug, and 'APOE' is an individual of the class Gene. This design is beneficial when the ontology populates a graph database where each individual corresponds to a node, data properties correspond to node attributes, and object properties correspond to edges.</rdfs:comment>
        <rdfs:label xml:lang="en">CardioKB Ontology</rdfs:label>
        <owl:versionInfo xml:lang="en">1.0.0</owl:versionInfo>
    </owl:Ontology>

    <!-- Annotation properties -->

    <owl:AnnotationProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#language"/>

    <owl:AnnotationProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#individualLabelPrefix">
        <rdfs:comment>String prefix that precedes the unique label on a named individual of the corresponding class.</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#sourceDatabase">
        <rdfs:comment>The primary source database for this entity type.</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#edgeSource">
        <rdfs:comment>The source database for this relationship type.</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:AnnotationProperty>

    <!-- Datatype Properties - Base Properties -->

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#commonName">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Common name of the entity</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#identifier">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Primary identifier for the entity</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#definition">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Textual definition of a term</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#dbXref">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Database cross-reference</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Datatype Properties - Gene Properties -->

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#geneDataProperty"/>

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#geneSymbol">
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#geneDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Gene"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>HGNC gene symbol</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#xrefEntrezGene">
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#geneDataProperty"/>
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#dbXref"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Gene"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>NCBI Entrez Gene ID</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#xrefEnsembl">
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#geneDataProperty"/>
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#dbXref"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Gene"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Ensembl gene ID</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#xrefUniProt">
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#geneDataProperty"/>
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#dbXref"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Gene"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>UniProt accession</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#specificityScore">
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#geneDataProperty"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Gene"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment>CVD specificity score computed from disease associations</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Datatype Properties - Disease Properties -->

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#diseaseDataProperty"/>

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#xrefDiseaseOntology">
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#diseaseDataProperty"/>
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#dbXref"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Disease"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Disease Ontology ID (DOID)</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#xrefMeSHDisease">
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#diseaseDataProperty"/>
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#dbXref"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Disease"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>MeSH disease ID</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#xrefOMIM">
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#diseaseDataProperty"/>
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#dbXref"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Disease"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>OMIM disease ID</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Datatype Properties - Drug Properties -->

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#drugDataProperty"/>

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#xrefDrugBankID">
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#drugDataProperty"/>
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#dbXref"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Drug"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>DrugBank ID</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#xrefPubChemCID">
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#drugDataProperty"/>
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#dbXref"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Drug"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>PubChem compound ID</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#drugSMILES">
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#drugDataProperty"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Drug"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>SMILES structure representation</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#drugInChI">
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#drugDataProperty"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Drug"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>InChI structure representation</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Datatype Properties - Variant Properties -->

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#variantDataProperty"/>

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#variantId">
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#variantDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Variant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>ClinVar variant ID</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#xrefDbSNP">
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#variantDataProperty"/>
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#dbXref"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Variant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>dbSNP rsID</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#clinicalSignificance">
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#variantDataProperty"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Variant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>ClinVar clinical significance classification</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Datatype Properties - Clinical Trial Properties -->

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#clinicalTrialDataProperty"/>

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#trialId">
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#clinicalTrialDataProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#ClinicalTrial"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>ClinicalTrials.gov NCT ID</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#trialPhase">
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#clinicalTrialDataProperty"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#ClinicalTrial"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Clinical trial phase</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#trialStatus">
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#clinicalTrialDataProperty"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#ClinicalTrial"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Current trial status</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Datatype Properties - Ontology Term Properties -->

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#geneOntologyId">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Gene Ontology ID (GO:XXXXXXX)</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#xrefUberon">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#BodyPart"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Uberon anatomy ID</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#xrefHPO">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Phenotype"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Human Phenotype Ontology ID</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#xrefMeSH">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Symptom"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>MeSH ID</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#xrefUmlsCUI">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#SideEffect"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>UMLS Concept Unique Identifier</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Datatype Properties - Relationship Edge Properties -->

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#associationScore">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment>Association score from source database</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#confidence">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment>Confidence score</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#expressionScore">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment>Expression score from Bgee</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#morScore">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment>Mode of regulation score from DoRothEA</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#zScore">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:comment>Z-score from LINCS L1000</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#source">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Source database for this relationship</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Object Properties - Base Property Hierarchies -->

    <owl:ObjectProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#geneObjectProperty"/>
    <owl:ObjectProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#diseaseObjectProperty"/>
    <owl:ObjectProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#drugObjectProperty"/>
    <owl:ObjectProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#variantObjectProperty"/>
    <owl:ObjectProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#clinicalTrialObjectProperty"/>

    <!-- Object Properties - Gene-Disease Associations -->

    <owl:ObjectProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#geneAssociatesWithDisease">
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#geneObjectProperty"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Gene"/>
        <rdfs:range rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Disease"/>
        <cardiokb:edgeSource>OpenTargets</cardiokb:edgeSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#diseaseAssociatesWithGene">
        <owl:inverseOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#geneAssociatesWithDisease"/>
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#diseaseObjectProperty"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Disease"/>
        <rdfs:range rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Gene"/>
    </owl:ObjectProperty>

    <!-- Object Properties - Gene-Gene Interactions -->

    <owl:ObjectProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#geneInteractsWithGene">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#geneObjectProperty"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Gene"/>
        <rdfs:range rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Gene"/>
        <cardiokb:edgeSource>STRING</cardiokb:edgeSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#geneRegulatesGene">
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#geneObjectProperty"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Gene"/>
        <rdfs:range rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Gene"/>
        <cardiokb:edgeSource>LINCS L1000</cardiokb:edgeSource>
    </owl:ObjectProperty>

    <!-- Object Properties - Gene Ontology Associations -->

    <owl:ObjectProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#geneParticipatesInBiologicalProcess">
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#geneObjectProperty"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Gene"/>
        <rdfs:range rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#BiologicalProcess"/>
        <cardiokb:edgeSource>Gene Ontology</cardiokb:edgeSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#geneHasMolecularFunction">
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#geneObjectProperty"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Gene"/>
        <rdfs:range rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#MolecularFunction"/>
        <cardiokb:edgeSource>Gene Ontology</cardiokb:edgeSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#geneAssociatedWithCellularComponent">
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#geneObjectProperty"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Gene"/>
        <rdfs:range rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#CellularComponent"/>
        <cardiokb:edgeSource>Gene Ontology</cardiokb:edgeSource>
    </owl:ObjectProperty>

    <!-- Object Properties - Gene-Pathway -->

    <owl:ObjectProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#geneInPathway">
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#geneObjectProperty"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Gene"/>
        <rdfs:range rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Pathway"/>
        <cardiokb:edgeSource>Reactome</cardiokb:edgeSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#pathwayContainsGene">
        <owl:inverseOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#geneInPathway"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Pathway"/>
        <rdfs:range rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Gene"/>
    </owl:ObjectProperty>

    <!-- Object Properties - Gene-Phenotype -->

    <owl:ObjectProperty rdf:about="http://cardiokb.org/ontologies/cardiokb.owl#geneAssociatesWithPhenotype">
        <rdfs:subPropertyOf rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#geneObjectProperty"/>
        <rdfs:domain rdf:resource="http://cardiokb.org/ontologies/cardiokb.owl#Gene"/>
