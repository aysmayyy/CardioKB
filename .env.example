# =============================================================================
# CardioKB Environment Variables
# Copy this file to .env and fill in the values before deploying.
# =============================================================================

# --- Memgraph (required) ---
# Connection URI for the Memgraph graph database.
# When running via Docker Compose, the app auto-connects to bolt://memgraph:7687.
# For local development outside Docker, use bolt://localhost:7687.
MEMGRAPH_URI=bolt://localhost:7687

# Memgraph authentication. Leave MEMGRAPH_USERNAME blank for default.
# MEMGRAPH_PASSWORD is required — the web app will return 503 on all graph
# endpoints if this is not set.
MEMGRAPH_USERNAME=
MEMGRAPH_PASSWORD=

# --- AI Agents (required for Build Knowledge Graph feature) ---
# Anthropic API key for the DiseaseQueryAgent and DatabaseAgent.
# Powers the "Build Knowledge Graph" sidebar feature that enriches the graph
# with clinical trials for any disease on demand via Claude API.
# Get a key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Admin (required for pipeline/admin features) ---
# Password for admin-only web interface features:
#   - Running the full ETL pipeline from the UI
#   - Adding new database sources via the DatabaseAgent
# Set to any secure string. Users must enter this in the Admin panel.
ADMIN_PASSWORD=

# --- DrugBank (optional) ---
# Only needed if re-running the pipeline to rebuild the graph from scratch.
# Alternatively, place the DrugBank XML file at data/raw/drugbank/ and
# these credentials are not needed.
DRUGBANK_USERNAME=
DRUGBANK_PASSWORD=
