DownloadSection() {

  dir="$1"

  if [ "$useFtp" = true ]
  then
    nquire -lst ftp.ncbi.nlm.nih.gov pubmed "$dir" |
    grep -v ".md5" | grep ".xml.gz" | grep -v ".xml.gz.tmp" |
    skip-if-file-exists |
    while read fl
    do
      sleep 1
      echo "$fl" >&2
      DownloadOneByFTP "$dir" "$fl"
    done
  elif [ "$useHttps" = true ]
  then
    nquire -get https://ftp.ncbi.nlm.nih.gov pubmed "$dir" |
    xtract -pattern a -if a -starts-with pubmed -and a -ends-with ".xml.gz" -element a |
    skip-if-file-exists |
    while read fl
    do
      sleep 1
      echo "$fl" >&2
      DownloadOneByHTTPS "$dir" "$fl"
    done
  fi
}

# -custom flag contains esearch -query string to select subset of PubMed records

if [ -d "${sourceBase}" ] && [ -n "$custom" ]
then
  cd "${sourceBase}"

  fname=$( echo "$custom" | sed -e 's/\[[^][]*\]//g' | sed -e 's/[[:punct:]]//g' | tr -d ' ' |  tr '[A-Z]' '[a-z]' )
  # download PubMed files for selected query (e.g., "J Exp Med [JOUR]")
  if [ ! -f "${fname}.xml" ]
  then
    esearch -db pubmed -query "${custom}" |
    efetch -format xml -log > "${fname}.xml"
  fi

  if [ -f "${fname}.xml" ]
  then
    rm -f pubmed*
    cat "${fname}.xml" |
    xtract -set PubmedArticleSet -pattern PubmedArticle \
      -split-by-num 30000 -prefix pubmed -suffix xml
  fi

  for fl in pubmed*
  do
    echo "${fl}.gz" >&2
    gzip "$fl"
  done

  exit 0
fi

# normal download of PubMed release files

if [ -d "${sourceBase}" ]
then
  cd "${sourceBase}"

  DownloadSection "baseline"
  if [ $? -ne 0 ]
  then
    DownloadSection "baseline"
  fi
  DownloadSection "updatefiles"
  if [ $? -ne 0 ]
  then
    DownloadSection "updatefiles"
  fi

  exit 0
fi

# warn if no source directory

DisplayError "Source directory '${sourceBase}' not found"
exit 1
